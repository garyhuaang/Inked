// Data model per Tattoo-Directory-Spec.md.
// Scope note: `users` and `claims` are deliberately absent — the claim flow is
// step 6 of the spec's sequence and needs Auth.js. `artists.claimed_by` arrives
// with them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Metro {
  dfw
  austin
}

model Shop {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  address   String
  city      String
  metro     Metro
  lat       Float
  lng       Float
  website   String?
  phone     String?
  instagram String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  artists ArtistShop[]

  @@index([lat, lng])
  @@map("shops")
}

model Artist {
  id               String   @id @default(uuid(7)) @db.Uuid
  name             String
  slug             String   @unique
  instagram        String?
  bio              String?
  acceptingClients Boolean  @default(false) @map("accepting_clients")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shops  ArtistShop[]
  styles ArtistStyle[]

  @@index([name, id])
  @@map("artists")
}

// 
model ArtistShop {
  artistId  String  @map("artist_id") @db.Uuid
  shopId    String  @map("shop_id") @db.Uuid
  isPrimary Boolean @default(false) @map("is_primary")
  isGuest   Boolean @default(false) @map("is_guest")

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([artistId, shopId])   
  @@index([shopId]) // The PK only serves artist->shops; /api/shops joins the other way.
  @@map("artist_shops")
}

model Style {
  id   String @id @default(uuid(7)) @db.Uuid
  name String @unique
  slug String @unique

  artists ArtistStyle[]

  @@map("styles")
}

model ArtistStyle {
  artistId String @map("artist_id") @db.Uuid
  styleId  String @map("style_id") @db.Uuid

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  style  Style  @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([artistId, styleId])
  @@index([styleId])  // Reverse direction: style->artists queries and Style deletion cascades.
  @@map("artist_styles")
}
