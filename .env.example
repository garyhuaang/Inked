# Neon Postgres. Copy to .env and fill in from the Neon dashboard.
#
# DATABASE_URL — the POOLED connection (host contains "-pooler"). Used by the
# app at runtime; serverless functions open many short-lived connections, which
# is what the pooler is for.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL — the same database WITHOUT "-pooler". Migrations run DDL, which
# fails over the pooler. Used only by the Prisma CLI, never at runtime.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
